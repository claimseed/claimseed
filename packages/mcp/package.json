{
  "name": "@claimseed/mcp",
  "version": "0.3.0",
  "mcpName": "io.github.claimseed/claimseed",
  "description": "MCP server for claimseed: lets an agent list, generate and render synthetic medical-billing specimen documents (shown as page images in the chat or written to one workspace folder) and score extractors against them",
  "license": "Apache-2.0",
  "author": "claimseed maintainers <maintainers@gildage.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claimseed/claimseed.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/claimseed/claimseed/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/claimseed/claimseed/issues"
  },
  "type": "module",
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "claimseed-mcp": "src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "sync-resources": "node scripts/sync-resources.js"
  },
  "dependencies": {
    "@claimseed/core": "0.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "files": [
    "src",
    "resources",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "devDependencies": {
    "pdf-lib": "1.17.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
