{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/claimseed/claimseed/blob/main/schemas/ground-truth.schema.json",
  "title": "claimseed ground truth",
  "description": "What a rendered specimen (or a set of paired specimens) contains and which errors were deliberately injected. Produced alongside every render; consumed by test harnesses to score an extractor or bill-review system. Version 1.4 is written only for a layout variant: documents[0].layout is <type>.<id> and documents[0].layoutVariant records the variant. All else, except the page count and the PDF hash, matches the standard document's key.",
  "type": "object",
  "required": [
    "schemaVersion",
    "documents",
    "errors",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5",
        "1.6"
      ],
      "description": "1.1 adds decoys and, on errors, relatedLineRef and relatedFieldRef (claimseed 0.3.0). 1.2 adds degradationParams on documents (no published claimseed release writes 1.2). 1.3 adds the patient's share in its parts on each claim line (coinsurance, copay, nonCovered, with toDeductible), deductibleMetBefore, the X12 835 remittance as a document (format x12, transactions, payer) and x12Ref on errors (claimseed 0.4.0 and later write 1.3). 1.4 adds documents[0].layoutVariant ({ id, columns, labels, style, breaks }) and a documents[0].layout of the form <type>.<id> (claimseed 0.5.0 and later write 1.4 only for a document rendered with a layout variant and still write 1.3 for every other document). Version 1.5 adds the `blind` object, and claimseed 0.6.0 writes 1.5 for every blind document, with or without a layout variant, and never for any other document. Version 1.6 adds the `pair` object and, on the errors and decoys of a provider's statement, `relatedDocumentFieldRef`, and claimseed 0.7.0 writes 1.6 for both documents of a pair, blind or not, with or without a layout variant on the EOB, and never for any other document. In every version it writes (1.3 to 1.6), claimseed 0.7.0 also writes relatedLineRef and relatedFieldRef on a decoy that repeats another line; keys written by 0.6.0 and earlier never have them."
    },
    "seed": {
      "type": "string",
      "description": "The seed every value was derived from; same seed + same version = same output."
    },
    "blind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "salt",
        "seed",
        "layoutVariant"
      ],
      "description": "Present only on a blind document, whose footer, PDF title and file names carry only an opaque id: the id, the salt and what the caller asked for.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^doc-[0-9a-f]{16}$",
          "description": "The opaque id printed in the document's footer, PDF title and file names: doc- followed by 16 hexadecimal digits."
        },
        "salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "The salt of the set, 32 lowercase hexadecimal digits; passing it again makes the same set."
        },
        "seed": {
          "type": "string",
          "description": "The seed as the caller asked for it, not the seed derived from the salt that the content was generated from."
        },
        "layoutVariant": {
          "type": [
            "string",
            "null"
          ],
          "description": "The layout variant as the caller asked for it, or null when none was asked for."
        },
        "copyOf": {
          "type": "string",
          "pattern": "^doc-[0-9a-f]{16}$",
          "description": "On a degraded copy only, the id of the blind document it was copied from."
        },
        "set": {
          "type": "string",
          "enum": [
            "standard"
          ],
          "description": "The name of the published set this document belongs to; present only on a document of a published set."
        },
        "canary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "A fixed string that marks claimseed answer keys, so that people who train models can find and leave them out, and people who test a model can check whether it has seen them; present only on a document of a published set."
        }
      },
      "dependentRequired": {
        "set": [
          "canary"
        ],
        "canary": [
          "set"
        ]
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "with",
        "claim",
        "variant",
        "params"
      ],
      "description": "Links this document to the other document of its pair: a Medicare Advantage EOB and the provider's statement for one of its claims. Present only on the two documents of a pair.",
      "properties": {
        "role": {
          "enum": [
            "eob",
            "bill"
          ],
          "description": "This document's place in the pair: `eob` for the Medicare Advantage EOB, `bill` for the provider's statement."
        },
        "with": {
          "type": [
            "string",
            "null"
          ],
          "description": "The id of the other document of the pair."
        },
        "claim": {
          "type": "integer",
          "minimum": 0,
          "description": "Which claim of the EOB the provider's statement bills, counted from 0."
        },
        "variant": {
          "enum": [
            "clean",
            "over-owed",
            "denied-line-billed",
            "payment-misposted",
            "paid-at-visit",
            "over-owed-with-payment"
          ],
          "description": "The statement variant: `clean`, `over-owed`, `denied-line-billed`, `payment-misposted`, `paid-at-visit` or `over-owed-with-payment`."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "description": "The statement variant's amounts, in dollars given to the cent (for example `by: 9.84` is $9.84): `by` for an error and `amount` for the decoy.",
          "properties": {
            "by": {
              "type": "number"
            },
            "amount": {
              "type": "number"
            }
          }
        }
      }
    },
    "scenario": {
      "type": "string",
      "description": "Scenario reference, <type>.<slug>, e.g. msn.duplicate-charge"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "pages"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Document type slug: msn, itemized-bill, ppo-eob or hmo-eob; x12-835 for a remittance file written beside one; provider-statement for the provider's statement paired with a ppo-eob or hmo-eob."
          },
          "layout": {
            "type": "string",
            "description": "Layout slug the type was rendered with"
          },
          "pages": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "Page count of the rendered PDF; null in `generate` output (known only after layout)"
          },
          "format": {
            "enum": [
              "pdf",
              "png",
              "jpg",
              "x12"
            ]
          },
          "degradation": {
            "type": [
              "string",
              "null"
            ],
            "description": "Degradation recipe applied (scan, fax, photo or low-res), or null for a clean render"
          },
          "degradationParams": {
            "type": [
              "object",
              "null"
            ],
            "description": "The seeded settings of the degradation (resolution, rotation, noise and the rest), or null for a clean render. Schema 1.2.",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean",
                "array"
              ]
            }
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the PDF bytes; null in `generate` output"
          },
          "fields": {
            "type": "object",
            "description": "Every rendered value, keyed by a stable path for this layout (e.g. claims[0].lineItems[1].amountProviderCharged). Values are the generated values: numbers for amounts (the page prints them formatted, e.g. 1,234.50), strings for text and dates as printed, booleans/null for flags. Internal keys (carrier, scenario, hasDenial, keys starting with _) are never included. metadata.pageCount is set from the finished PDF.",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "entities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "patient": {
                "$ref": "#/$defs/person"
              },
              "providers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/provider"
                }
              },
              "payer": {
                "$ref": "#/$defs/payer"
              },
              "identifiers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "member id, claim numbers, account numbers, MBI as printed"
              }
            }
          },
          "transactions": {
            "type": "array",
            "description": "For an x12-835 document: one entry per transaction (one per payee)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "controlNumber",
                "payeeNpi",
                "paymentAmount",
                "handlingCode",
                "paymentMethod",
                "traceNumber"
              ],
              "properties": {
                "controlNumber": {
                  "type": "string",
                  "pattern": "^(?!0+$)[0-9]{4,9}$"
                },
                "payeeNpi": {
                  "type": "string",
                  "pattern": "^9[0-9]{9}$"
                },
                "payeeTaxId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^00[0-9]{7}$"
                },
                "traceNumber": {
                  "type": "string",
                  "pattern": "^CS[A-Z0-9]+$"
                },
                "paymentAmount": {
                  "type": "number"
                },
                "handlingCode": {
                  "enum": [
                    "I",
                    "H"
                  ]
                },
                "paymentMethod": {
                  "enum": [
                    "CHK",
                    "NON"
                  ]
                }
              }
            }
          },
          "payer": {
            "type": "object",
            "additionalProperties": false,
            "description": "For an x12-835 document: the payer as the file names it",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CS[A-Z0-9]+$"
              },
              "taxId": {
                "type": "string",
                "pattern": "^00[0-9]{7}$"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "taxId",
              "name"
            ]
          },
          "layoutVariant": {
            "type": "object",
            "required": [
              "id",
              "columns",
              "labels",
              "style",
              "breaks"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][0-9]{2}$"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z(),]+$"
                }
              },
              "labels": {
                "enum": [
                  "base",
                  "alt-a",
                  "alt-b"
                ]
              },
              "style": {
                "type": "string",
                "pattern": "^s[0-9]+$"
              },
              "breaks": {
                "enum": [
                  "repeat",
                  "marker"
                ]
              }
            }
          }
        },
        "if": {
          "required": [
            "layoutVariant"
          ]
        },
        "then": {
          "required": [
            "layout"
          ],
          "properties": {
            "layout": {
              "pattern": "^[a-z-]+\\.[a-z0-9-]+$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "layout": {
                  "pattern": "^[a-z0-9-]+\\.[a-z0-9]+$"
                }
              },
              "required": [
                "layout"
              ]
            },
            "then": {
              "required": [
                "layoutVariant"
              ]
            }
          },
          {
            "if": {
              "required": [
                "layoutVariant"
              ]
            },
            "then": {
              "required": [
                "layout"
              ],
              "properties": {
                "layout": {
                  "pattern": "^[a-z0-9-]+\\.[a-z0-9]+$"
                }
              }
            }
          }
        ]
      }
    },
    "errors": {
      "type": "array",
      "description": "Deliberately injected errors. Empty for a clean control.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "documentId",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "description": "Slug from docs/error-taxonomy.md"
          },
          "documentId": {
            "type": "string"
          },
          "lineRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path into the top-level `claims` block (the adjudication model, same shape for every layout), e.g. claims[0].lines[1] or claims[2].totals.patientMayBeBilled; null for document-level errors"
          },
          "relatedLineRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "For an error that involves a second line (the original line of a duplicate charge), that line's path in the claims block; a report naming either line finds the error"
          },
          "relatedDocumentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "For cross-document errors, the document this one conflicts with"
          },
          "relatedDocumentFieldRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "On an error or decoy of the provider's statement, the same place on the EOB, as a path into the EOB's fields."
          },
          "expected": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "Correct value"
          },
          "actual": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "Value as printed"
          },
          "delta": {
            "type": [
              "number",
              "null"
            ],
            "description": "Dollar impact to the patient, positive = overcharged"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "rule": {
            "type": "string",
            "description": "Public rule the error violates (statute, CFR, NCCI, NCD, fee schedule), as cited in docs/error-taxonomy.md"
          },
          "note": {
            "type": "string"
          },
          "fieldRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same location as a path into documents[0].fields for this layout (e.g. claims[0].lineItems[1] on an MSN, revenueCodeGroups[0].lineItems[1] on an itemized bill); null when the error has no printed location"
          },
          "relatedFieldRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same second line as relatedLineRef, as a path into documents[0].fields"
          },
          "x12Ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the error sits in the 835 written beside the document: <ST02>:CLP<n>:<element> or <ST02>:CLP<n>:SVC<n>",
            "pattern": "^(?!0+:)[0-9]{4,9}:CLP[1-9][0-9]*:(SVC[1-9][0-9]*|CLP(0[1-9]|1[0-3]))$"
          }
        }
      }
    },
    "decoys": {
      "type": "array",
      "description": "Hard negatives: lines that look like errors but follow the rules, each with the public rule that makes it correct. A report that flags a decoy counts it as a false alarm. Empty when the scenario plants none.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "documentId",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable within one answer key: decoy-1, decoy-2, ..."
          },
          "kind": {
            "type": "string",
            "description": "Decoy slug from docs/error-taxonomy.md (the Decoys section)"
          },
          "documentId": {
            "type": "string"
          },
          "lineRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path into the claims block"
          },
          "relatedLineRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "For a decoy that repeats a service on another date (two separate visits, not a duplicate), the path in the claims block of the line it repeats; a flag on either line counts as flagging the decoy (a false alarm)"
          },
          "relatedFieldRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same repeated line as relatedLineRef, as a path into documents[0].fields"
          },
          "relatedDocumentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "For cross-document errors, the document this one conflicts with"
          },
          "relatedDocumentFieldRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "On an error or decoy of the provider's statement, the same place on the EOB, as a path into the EOB's fields."
          },
          "fieldRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same place as a path into documents[0].fields"
          },
          "rule": {
            "type": "string",
            "description": "Public rule that makes the line correct"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "documentGaps": {
      "type": "array",
      "description": "Things a reviewer would need that the specimen deliberately does not contain (missing EOB for a bill, missing page, unreadable region).",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "adversarial": {
      "type": "boolean",
      "default": false,
      "description": "True if the specimen contains text designed to manipulate an automated reader (prompt injection). Consumers that feed specimens to automated readers should filter on this flag."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Public sources the scenario's structure, codes, amounts and rules were taken from. Required; CI rejects scenarios without one.",
      "items": {
        "type": "object",
        "required": [
          "what",
          "source"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "URL or citation"
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "description": "Status of the price data the amounts were computed from",
      "properties": {
        "status": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "claims": {
      "type": "array",
      "description": "Adjudication model the document was assembled from: one entry per claim, with per-line charged/allowed/paid/patient amounts after any injected errors. lineRef paths resolve against this block.",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "dateOfService",
          "lines",
          "totals"
        ],
        "additionalProperties": false,
        "properties": {
          "claimNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string"
          },
          "dateOfService": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "units": {
                  "type": "integer"
                },
                "dateOfService": {
                  "type": "string"
                },
                "charged": {
                  "type": "number"
                },
                "allowed": {
                  "type": "number"
                },
                "approved": {
                  "type": "boolean"
                },
                "paid": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "toDeductible": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "coinsurance": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "The patient's coinsurance on the line"
                },
                "copay": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "The patient's copay on the line (0 under Part B)"
                },
                "nonCovered": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "What the patient may be billed for a line that is not covered (a denied service the patient agreed to pay for); 0 otherwise"
                },
                "patientMayBeBilled": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "totals": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "deductibleMetBefore": {
      "type": [
        "number",
        "null"
      ],
      "description": "Deductible already met before this document's claims; the claim lines' toDeductible add up to the printed deductible met minus this amount"
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "dob": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "npi": {
          "type": "string",
          "pattern": "^9[0-9]{9}$",
          "description": "Synthetic NPIs always start with 9"
        },
        "specialty": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "participating": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "payer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "planType": {
          "type": "string"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\(?[2-9][0-9]{2}\\)?[ -]?555-01[0-9]{2}$",
          "description": "Geographic area code + 555-01xx only"
        },
        "planName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              "1.3",
              "1.4",
              "1.5",
              "1.6"
            ]
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "deductibleMetBefore",
          "claims"
        ],
        "properties": {
          "claims": {
            "items": {
              "properties": {
                "lines": {
                  "items": {
                    "required": [
                      "toDeductible",
                      "coinsurance",
                      "copay",
                      "nonCovered",
                      "patientMayBeBilled"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.4"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "documents": {
            "contains": {
              "required": [
                "layoutVariant"
              ]
            }
          }
        }
      }
